{
  "name": "ts-routes",
  "version": "2.0.0",
  "description": "Strongly typed routes management",
  "main": "lib/index.cjs.js",
  "module": "lib/index.esm.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "jest",
    "test:types": "tsd",
    "pretest:types": "npm run build",
    "build": "rollup -c",
    "prebuild": "rm -rf lib",
    "lint": "eslint src/** __tests__/**"
  },
  "directories": {
    "lib": "lib"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leancodepl/ts-routes.git"
  },
  "keywords": [
    "routes",
    "typescript",
    "path-to-regexp",
    "react-router",
    "strongly",
    "typed",
    "paths",
    "pattern",
    "routing"
  ],
  "author": "LeanCode",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/leancodepl/ts-routes/issues"
  },
  "homepage": "https://github.com/leancodepl/ts-routes#readme",
  "dependencies": {
    "path-to-regexp": ">=6.0.0 < 7.0.0",
    "qs": ">=6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "9.37.0",
    "@jest/globals": "30.2.0",
    "@leancodepl/eslint-config": "9.6.3",
    "@leancodepl/prettier-config": "9.6.3",
    "@rollup/plugin-typescript": "12.1.4",
    "@types/node": "^22.0.0",
    "@types/qs": "6.14.0",
    "eslint-plugin-prettier": "5.5.4",
    "jest": "30.2.0",
    "rollup": "4.52.4",
    "ts-jest": "29.4.5",
    "tsd": "0.33.0",
    "tslib": "2.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1"
  },
  "tsd": {
    "directory": "__tests__/types"
  }
}
